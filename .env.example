# GameNest Backend — example environment variables.
# Copy to .env (ignored by Git) and replace every placeholder. Never commit real values.
# The application does not read .env files by itself: use it with `docker run --env-file .env`,
# or enter the same names in the Render Dashboard (Environment).

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL connection string in Npgsql keyword format (not a postgresql:// URI).
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=VerifyFull

# JWT signing key: at least 32 bytes; generate 64 random bytes (see README). Never reuse a development key.
Jwt__Key=<base64-encoded-random-64-bytes>
Jwt__Issuer=GameNestAPI
Jwt__Audience=GameNestClients

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (not a secret; no client secret is needed).
Google__ClientId=<numbers-and-letters>.apps.googleusercontent.com

# Email/password flow (kept in the code, off for the Google-only MVP).
# Set Auth__PasswordLoginEnabled=true only temporarily, so existing users can link Google; then set it back to false.
Auth__PasswordRegistrationEnabled=false
Auth__PasswordLoginEnabled=false

# Comma-separated list of allowed browser origins (no paths, no wildcards).
CORS_ALLOWED_ORIGINS=https://gamenest.pp.ua

# Frontend page that confirms an email address; ?email=...&token=... is appended.
# Required when Resend is configured.
Email__ConfirmationUrlBase=https://gamenest.pp.ua/confirm-email

# Resend email API (https://resend.com). Only needed when Auth__PasswordRegistrationEnabled=true.
# Set all of them or none of them.
Resend__ApiKey=<resend-api-key>
Resend__FromEmail=<no-reply@your-verified-domain>
Resend__FromName=GameNest

# Port to listen on. Render sets PORT automatically; do not set it there.
# Locally without PORT the Docker image listens on 8080.
# PORT=8080
